# Copy to .env and fill in. Never commit .env.
# Full API URL without group_id, in single quotes because it contains &.
# Take it from the guide PDF button or a teammate.
CQA_API_URL=''
# DEV for development. Organizers announce the control value at T+23.
CQA_GROUP_ID=DEV

# Evaluator: NVIDIA's free API. Create a key at build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
LLM_PROVIDER=nvidia
# A model may carry its provider: provider:model, e.g. local:qwen3:4b
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# single (frozen choice) | sections | per_criterion | facts_first | two_judges | vote | second_opinion | self_check
LLM_PIPELINE=single
# For two_judges: the second judge and the arbiter (provider:model). Empty: not used.
LLM_SECOND_MODEL=
LLM_ARBITER_MODEL=
# For second_opinion: criteria the second model re-checks, e.g. c07,c08. Empty: violation flags only.
LLM_SECOND_CRITERIA=
# Reasoning models spend tokens before the JSON. Super-VL used up to 19.2k on DEV; NVIDIA accepts 64000 even with a 20k-token prompt.
LLM_MAX_OUTPUT_TOKENS=64000
# Seconds one model call may take before it counts as hung. Super-VL writes about 180 tokens/s: 64000 tokens fit in about 360 s.
CQA_LLM_TIMEOUT_S=420
# Requests per minute allowed to NVIDIA from this process.
NVIDIA_RPM=35

# Optional free providers, unused unless a key is set (see ai/src/cqa_ai/providers/profiles.py).
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Local OpenAI-compatible server (Ollama by default).
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Calls arrive as transcripts and go to the configured model like chats (1, also when unset).
# 0 keeps them on local providers only: real calls hold personal data and the free API records input.
CQA_ALLOW_VOICE_TO_CLOUD=1

# Parallel evaluations in the backend queue and pause between model starts.
CQA_EVAL_CONCURRENCY=4
CQA_EVAL_PAUSE_S=2
# Seconds one dialogue may take in the backend before it is marked failed (primary, repair and fallback calls).
CQA_EVAL_TIMEOUT_S=1500
