# Copy to .env and fill in. Never commit .env.
# Full API URL without group_id, in single quotes because it contains &.
# Take it from the guide PDF button or a teammate.
CQA_API_URL=''
# DEV for development. Organizers announce the control value at T+23.
CQA_GROUP_ID=DEV

# Evaluator: NVIDIA's free API. Create a key at build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
LLM_PROVIDER=nvidia
LLM_MODEL=google/gemma-4-31b-it
LLM_FALLBACK_MODEL=mistralai/mistral-large-4-1t-a52b

# Real calls hold personal data and the free API records input. 1 allows sending them.
CQA_ALLOW_VOICE_TO_CLOUD=0
